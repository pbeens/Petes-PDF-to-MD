{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pete's PDF to MD",
  "version": "1.0.0",
  "identifier": "com.pbeens.petespdftomd",
  "build": {
    "frontendDist": "../../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pete's PDF to MD",
        "width": 1320,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 680,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
