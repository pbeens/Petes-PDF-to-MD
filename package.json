{
  "name": "petes-pdf-to-md",
  "version": "1.0.0",
  "description": "Open-source utility to convert PDF documents to high-quality Markdown for AI workflows.",
  "private": true,
  "scripts": {
    "convert": "cargo run --release --quiet --manifest-path rust/Cargo.toml -p petes-pdf-to-md --",
    "test:build": "cargo build --release --quiet --manifest-path rust/Cargo.toml -p petes-pdf-to-md",
    "test:smoke": "node ./scripts/test-smoke.js",
    "test:regression": "node ./scripts/test-regression.js",
    "test:rust": "cargo test --release --manifest-path rust/Cargo.toml",
    "test": "npm run test:build && npm run test:smoke && npm run test:regression",
    "gui": "cd rust/app && tauri dev",
    "gui:debug": "cd rust/app && PDF_TO_MD_DEBUG_BUILD=1 tauri dev",
    "build:mac": "./scripts/build-mac.sh",
    "build:mac:debug": "./scripts/build-mac.sh --debug",
    "version:show": "node ./scripts/bump-revision.js --print",
    "release:prep": "./scripts/release-prep.sh",
    "docs:preview": "quarto preview docs",
    "docs:render": "quarto render docs"
  },
  "keywords": [],
  "author": "Peter Beens",
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4"
  },
  "buildRevision": "c",
  "buildRevisionOf": "1.0.0"
}
